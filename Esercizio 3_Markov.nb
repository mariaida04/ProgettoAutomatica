Cell["Calcolo la matrice (I - A):", "Text",
 CellChangeTimes->{{3.93419182743548*^9, 
  3.9341918415695744`*^9}},ExpressionUUID->"24d5aa1e-61b3-42f4-b274-\
5fc4afb8758f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IdentityMatrix", "[", "3", "]"}], "-", "A"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.9341918437135963`*^9, 3.934191850608182*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"abe21b77-6e96-4270-9a62-ab9e1f5c3ae7"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["4", "7"], 
      RowBox[{"-", 
       FractionBox["10", "23"]}], 
      RowBox[{"-", 
       FractionBox["9", "25"]}]},
     {
      RowBox[{"-", 
       FractionBox["4", "7"]}], 
      FractionBox["18", "23"], 
      RowBox[{"-", 
       FractionBox["2", "5"]}]},
     {"0", 
      RowBox[{"-", 
       FractionBox["8", "23"]}], 
      FractionBox["19", "25"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.9341918516990175`*^9, 3.9341925629658155`*^9, 
  3.934192861851595*^9},
 CellLabel->
  "Out[27]//MatrixForm=",ExpressionUUID->"4d3198ae-7ab6-4a1f-b580-\
5742ecf9b7f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["4", "7"], "x1"}], "-", 
       RowBox[{
        FractionBox["10", "23"], "x2"}], "-", 
       RowBox[{
        FractionBox["9", "25"], "x3"}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["4", "7"]}], "x1"}], "+", 
       RowBox[{
        FractionBox["18", "23"], "x2"}], "-", 
       RowBox[{
        FractionBox["2", "5"], "x3"}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"x1", "+", "x2", "+", "x3"}], "==", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.934192745566642*^9, 3.9341928228117867`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"7eb29bf0-617e-4cf3-a191-14d18d88c343"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x1", "\[Rule]", 
     FractionBox["131", "313"]}], ",", 
    RowBox[{"x2", "\[Rule]", 
     FractionBox["874", "2191"]}], ",", 
    RowBox[{"x3", "\[Rule]", 
     FractionBox["400", "2191"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.934192869290027*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"a66d366f-147f-4abe-80fb-ed68584072b0"]
}, Open  ]],

