Cell["\<\
Scegliamo un numero di passi sufficientemente lungo rispetto al quale \
valutare la catena di Markov, in modo da evidenziare la convergenza dello \
stato stocastico ad un vettore di distribuzione di probabilit\[AGrave] \
stazionaria \[Pi].\
\>", "Text",
 CellChangeTimes->{{3.9341728079800944`*^9, 3.9341728209923887`*^9}, 
   3.934175108653739*^9, {3.934175235017377*^9, 3.934175304861339*^9}, {
   3.9341753445033293`*^9, 3.934175443510744*^9}, {3.9341773444423933`*^9, 
   3.934177437129404*^9}},ExpressionUUID->"0ba3203a-1eba-4dc6-a35f-\
33fde617d921"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"numpassi", " ", "=", " ", "100"}]], "Input",
 CellChangeTimes->{{3.9341728247862415`*^9, 3.9341728568391857`*^9}, {
  3.934173028441777*^9, 3.934173100614111*^9}, {3.934173325493038*^9, 
  3.934173331484307*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"c0239601-09e0-4e01-a25b-068813d7090e"],

Cell[BoxData["100"], "Output",
 CellChangeTimes->{{3.9341730613661437`*^9, 3.9341731011371703`*^9}, {
   3.934173326671548*^9, 3.934173332066268*^9}, 3.9341769384232674`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"717921db-c069-4eb6-af05-4037c6d234a7"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", "numpassi"}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{
    SubscriptBox["x0", "norm"], "=", 
    RowBox[{"A", ".", 
     SubscriptBox["x0", "norm"]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9341728650848007`*^9, 3.934172891106765*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"c544f1b8-9d34-4954-9ca7-66f99e4bace6"],

