 FractionBox[
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"67", " ", "z"}], "+", 
     RowBox[{"8", " ", 
      SuperscriptBox["z", "2"]}], "+", 
     RowBox[{"48", " ", 
      SuperscriptBox["z", "3"]}], "-", 
     RowBox[{"48", " ", 
      RowBox[{"U", "[", "z", "]"}]}]}], ")"}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"3", " ", "z"}]}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"4", " ", "z"}]}], ")"}], "2"]}]]], "Output",
 CellChangeTimes->{3.9340229896518364`*^9},
