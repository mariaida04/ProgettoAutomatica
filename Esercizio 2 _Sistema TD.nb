Cell["\<\
A partire dal modello ARMA trovato al punto precedente, isoliamo la risposta \
forzata Y(z) e sostituiamo a U(z) la Z-Trasformata della risposta al gradino\
\>", "Text",
 CellChangeTimes->{{3.934022726747402*^9, 3.9340227515553026`*^9}, {
  3.934023009006036*^9, 3.9340230127764835`*^9}, {3.9340232265862083`*^9, 
  3.9340232805172987`*^9}, {3.9340233778369155`*^9, 3.9340234554920626`*^9}, {
  3.9340234940471067`*^9, 3.9340235225166283`*^9}, {3.934044661459077*^9, 
  3.9340446651889997`*^9}},ExpressionUUID->"9e399826-948b-4248-8803-\
54c16a982acc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Y", "[", "z", "]"}], "=", 
  FractionBox[
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"67", " ", "z"}], "+", 
      RowBox[{"8", " ", 
       SuperscriptBox["z", "2"]}], "+", 
      RowBox[{"48", " ", 
       SuperscriptBox["z", "3"]}], "-", 
      RowBox[{"48", " ", 
       RowBox[{"U", "[", "z", "]"}]}]}], ")"}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"3", " ", "z"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"4", " ", "z"}]}], ")"}], "2"]}]]}]], "Input",
 CellChangeTimes->{{3.9340229110478773`*^9, 3.93402291351696*^9}, 
   3.934022984276631*^9},
 CellLabel->
  "In[101]:=",ExpressionUUID->"1254d46a-5e3f-4535-aeb3-35a37393d31d"],

