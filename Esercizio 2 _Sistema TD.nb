Cell[TextData[{
 "Una volta esaurito il transitorio, la risposta forzata si assesta sul \
valore costante relativo alla risposta a regime ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"-", 
     FractionBox["16", "3"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "0bd58b27-be78-4487-89b7-4350c490af17"],
 "."
}], "Text",
 CellChangeTimes->{{3.9339958986477537`*^9, 3.9339959474113283`*^9}, {
  3.93436399420697*^9, 
  3.9343640009011164`*^9}},ExpressionUUID->"a88da6c5-d13c-473a-9f13-\
2dfd80352a84"],

