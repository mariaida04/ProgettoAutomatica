Cell["\<\
Calcoliamo la risposta al segnale tramite una somma di convoluzione\
\>", "Text",
 CellChangeTimes->{{3.934018291284568*^9, 
  3.9340183282150655`*^9}},ExpressionUUID->"e2ae58f7-b4f2-4b46-b19d-\
