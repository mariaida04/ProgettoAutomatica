Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["y", "f"], "[", "k_", "]"}], ":=", " ", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"n", "=", "0"}], "k"], 
   RowBox[{
    RowBox[{"g", "[", "k", "]"}], "\[Times]", 
    RowBox[{"u", "[", 
     RowBox[{"k", "-", "n"}], "]"}]}]}]}]], "Input",
