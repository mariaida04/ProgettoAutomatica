Cell[TextData[{
 "Procediamo determinando la coppia ampiezza - fase della risposta a regime. \
Valutiamo le seguenti due equazioni in t = 0.\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"3645", " ", "cos", 
        RowBox[{"(", "t", ")"}]}], "841"]}], "-", 
     FractionBox[
      RowBox[{"1935", " ", 
