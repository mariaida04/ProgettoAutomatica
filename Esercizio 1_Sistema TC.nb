Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["yExp", "f"], "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    SubscriptBox["C", "1"], 
    RowBox[{"UnitStep", "[", "t", "]"}]}], "+", 
