    SubscriptBox["C", "22"], "t", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["2", "5"]}], "t"}], "]"}], 
    RowBox[{"UnitStep", "[", "t", "]"}]}], "+", 
   RowBox[{
    SubscriptBox["C", "31"], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "3"]}], "t"}], "]"}], 
    RowBox[{"UnitStep", "[", "t", "]"}]}], "+", 
   RowBox[{
    SubscriptBox["C", "32"], "t", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "3"]}], "t"}], "]"}], 
    RowBox[{"UnitStep", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", 
